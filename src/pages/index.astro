---
import settings from '../data/settings.json';
import hero from '../data/hero.json';
import content from '../data/content.json';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import '../site.css';

type GalleryEntry = { title: string; image: string; alt: string; visible?: boolean; order?: number };
type Menu = { title: string; dishes?: string[] };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
function image(path?: string) {
  if (!path) return '';
  if (!/^\/images\/(?:[\w-]+\/)*[\w.-]+\.(jpg|jpeg|png|webp)$/i.test(path) || !existsSync(resolve('public', '.' + path))) {
    throw new Error(`Ảnh không hợp lệ hoặc không tìm thấy: ${path}`);
  }
  return base + path;
}
function phone(value?: string) {
  if (!value) return '';
  if (!/^0\d{9}$/.test(value)) throw new Error('Số liên hệ phải có 10 chữ số, bắt đầu bằng 0');
  return value;
}
function external(value: string | undefined, allowed: string[]) {
  if (!value) return '';
  const url = new URL(value);
  if (url.protocol !== 'https:' || url.username || url.password || url.port || !allowed.includes(url.hostname)) {
    throw new Error('Liên kết liên hệ cần dùng HTTPS và đúng tên miền dịch vụ');
  }
  return url.href;
}
const desktop = image(hero.desktopImage);
const mobile = image(hero.mobileImage);
const logo = image(settings.logo);
const mainPhone = phone(settings.primaryPhone);
const secondary = phone(settings.secondaryPhone);
const zalo = phone(settings.zaloPhone);
const messenger = external(settings.messengerUrl, ['m.me', 'www.messenger.com', 'messenger.com']);
const map = external(settings.mapUrl, ['maps.app.goo.gl', 'maps.google.com', 'www.google.com']);
if (!mainPhone) throw new Error('Cần số điện thoại chính');
if ((desktop || mobile) && !hero.imageAlt.trim()) throw new Error('Cần mô tả ảnh đầu trang');
const focal = /^(?:100|\d{1,2})% (?:100|\d{1,2})%$/.test(hero.focalPoint) ? hero.focalPoint : '50% 50%';
const gallery = Object.values(import.meta.glob<GalleryEntry>('../data/gallery/*.json', { eager: true, import: 'default' }))
  .filter(entry => entry.visible)
  .map(entry => {
    if (!entry.title?.trim() || !entry.alt?.trim() || !entry.image) throw new Error('Ảnh hiển thị cần tên, file ảnh và mô tả');
    return { ...entry, url: image(entry.image) };
  })
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
const menus: Menu[] = content.menus ?? [];
const links = [['gioi-thieu', 'Giới thiệu'], ['dich-vu', 'Dịch vụ'], ['thuc-don', 'Thực đơn'], ['thu-vien', 'Thư viện'], ['faq', 'Hỏi đáp']];
const description = 'Dịch vụ Tiệc Cưới Thảo Hoàng. Tìm hiểu dịch vụ tiệc cưới, tiệc tại nhà, lễ đính hôn, trang trí và thực đơn.';
const canonical = new URL(base + '/', Astro.site).href;
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {import.meta.env.PUBLIC_SITE_INDEXABLE !== 'true' && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:title" content={settings.brandName} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {(desktop || mobile) && <meta property="og:image" content={new URL(desktop || mobile, Astro.site).href} />}
  <title>Dịch vụ Tiệc Cưới Thảo Hoàng</title>
</head>
<body>
  <a class="skip" href="#noi-dung">Đến nội dung</a>
  <header class="shell top" id="dau-trang">
    <a class="brand" href="#dau-trang">{logo ? <img src={logo} width="140" height="52" alt={settings.brandName} /> : <><span class="monogram" aria-hidden="true">TH</span><span>{settings.shortName}<small>DỊCH VỤ TIỆC CƯỚI</small></span></>}</a>
    <nav aria-label="Điều hướng chính">{links.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
    <a class="button outline" href="#lien-he">Liên hệ <span aria-hidden="true">↗</span></a>
  </header>
  <main id="noi-dung" tabindex="-1">
    <section class="shell hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">DỊCH VỤ TIỆC CƯỚI THẢO HOÀNG</p>
        <h1 id="hero-title">{hero.heading}</h1>
        <p>{settings.slogan}</p>
        <div class="actions"><a class="button solid" href="#lien-he">Tư vấn buổi tiệc <span aria-hidden="true">↗</span></a><a class="text-link" href="#dich-vu">Khám phá dịch vụ <span aria-hidden="true">↓</span></a></div>
      </div>
      <div class="hero-art">
        {desktop || mobile ? <picture>
          {mobile && <source media="(max-width: 700px)" srcset={mobile} />}
          <img src={desktop || mobile} alt={hero.imageAlt} width="1200" height="1400" fetchpriority="high" style={{ objectPosition: focal }} />
        </picture> : <div class="seal" aria-hidden="true"><span>TH</span><small>THẢO HOÀNG</small></div>}
      </div>
    </section>
    <section class="section shell intro" id="gioi-thieu">
      <div><p class="eyebrow">01 / GIỚI THIỆU</p><h2>{content.introTitle}</h2></div>
      <p>{content.intro}</p>
    </section>
    <div class="tinted">
      <section class="section shell" id="dich-vu">
        <p class="eyebrow">02 / DỊCH VỤ</p><h2>Dịch vụ tiệc & trang trí</h2>
        <div class="cards">{(content.services ?? []).map((service, index) => <article>
          <span class="card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{service.title}</h3><p>{service.description}</p>
        </article>)}</div>
      </section>
    </div>
    <section class="section shell intro" id="thuc-don">
      <div><p class="eyebrow">03 / THỰC ĐƠN</p><h2>Thực đơn cho buổi tiệc</h2></div>
      <div><p>{content.menuIntro}</p>
        {menus.length > 0 && menus.map(menu => <article class="menu"><h3>{menu.title}</h3><ul>{(menu.dishes ?? []).map(dish => <li>{dish}</li>)}</ul></article>)}
        <a class="text-link" href="#lien-he">Trao đổi về thực đơn <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <div class="tinted">
      <section class="section shell" id="thu-vien">
        <p class="eyebrow">04 / THƯ VIỆN</p><h2>Hình ảnh buổi tiệc</h2>
        {gallery.length ? <div class="gallery">{gallery.map(entry => <figure><a href={entry.url}><img src={entry.url} alt={entry.alt} width="800" height="1000" loading="lazy" decoding="async" /></a><figcaption>{entry.title}</figcaption></figure>)}</div> : <p class="empty">Thư viện sẽ được cập nhật với hình ảnh các buổi tiệc của Thảo Hoàng.</p>}
      </section>
    </div>
    <section class="section shell intro" id="faq">
      <div><p class="eyebrow">05 / HỎI ĐÁP</p><h2>Câu hỏi thường gặp</h2></div>
      <div>{(content.faq ?? []).map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
    </section>
    <div class="contact-band">
      <section class="section shell intro" id="lien-he">
        <div><p class="eyebrow">06 / LIÊN HỆ</p><h2>Cùng lên kế hoạch cho buổi tiệc</h2></div>
        <div><p>Hãy cho Thảo Hoàng biết ngày dự kiến, địa điểm và số lượng khách.</p>
          {settings.address && <p>{settings.address}</p>}
          <div class="actions">
            <a class="button solid" href={`tel:${mainPhone}`}>Gọi {mainPhone}</a>
            {zalo && <a class="button outline" href={`https://zalo.me/${zalo}`}>Zalo</a>}
            {messenger && <a class="button outline" href={messenger}>Messenger</a>}
          </div>
          {secondary && <p>Số phụ <a class="text-link" href={`tel:${secondary}`}>{secondary}</a></p>}
          {map && <a class="text-link" href={map}>Xem bản đồ ↗</a>}
        </div>
      </section>
    </div>
  </main>
  <footer class="shell"><span>{settings.shortName} · {settings.slogan}</span><a href="#dau-trang">Về đầu trang ↑</a></footer>
</body>
</html>



